# Copiez ce fichier en .env et remplissez les valeurs.

# Clé API Claude (server-side uniquement — jamais exposée au client)
ANTHROPIC_API_KEY=

# Secret partagé backend <-> IA (authentification service-à-service).
# Générez-le avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-generate-a-strong-secret

AI_ENV=development
DEFAULT_MAX_TOKENS=1024
# Plafond de coût cumulé par workspace en $ (0 = illimité). Protège la facture LLM.
MAX_COST_PER_WORKSPACE=0

# --- Sources de prospection (optionnelles) ---------------------------------
# Sans ces cles, le sourcing fonctionne en mode simulation (dry_run) : il montre
# les requetes qui seraient envoyees, sans appeler les API ni facturer.
APOLLO_API_KEY=
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
